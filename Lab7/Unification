
# Unification in First Order Logic

def is_variable(term):
    return term[0].islower()

def apply_substitution(term, substitutions):
    while term in substitutions:
        term = substitutions[term]
    return term

def unify_terms(t1, t2, substitutions):

    t1 = apply_substitution(t1, substitutions)
    t2 = apply_substitution(t2, substitutions)

    if t1 == t2:
        return True

    if is_variable(t1):
        substitutions[t1] = t2
        return True

    if is_variable(t2):
        substitutions[t2] = t1
        return True

    return False

def parse_expression(expression):
    name, arguments = expression.split("(", 1)
    arguments = arguments.rstrip(")")
    args = [x.strip() for x in arguments.split(",")]
    return name.strip(), args

def unification(expr1, expr2):

    predicate1, args1 = parse_expression(expr1)
    predicate2, args2 = parse_expression(expr2)

    substitutions = {}

    # Check predicate names
    if predicate1 != predicate2:
        print("Unification Failed: Different predicates")
        return

    # Check number of arguments
    if len(args1) != len(args2):
        print("Unification Failed: Different number of arguments")
        return

    # Unify arguments one by one
    for a, b in zip(args1, args2):
        if not unify_terms(a, b, substitutions):
            print("Unification Failed")
            return

    print("Unification Successful!")
    print("Substitution Set:")

    if substitutions:
        for key, value in substitutions.items():
            print(key, "=", apply_substitution(value, substitutions))
    else:
        print("No substitution required")

# Given expressions
expr1 = "Eats(x, Apple)"
expr2 = "Eats(Riya, y)"

print("Expression 1:", expr1)
print("Expression 2:", expr2)

unification(expr1, expr2)
